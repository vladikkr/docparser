# DocParser.ru - Environment Variables
# Copy this file to .env and fill in your values

# App
APP_NAME=DocParser.ru
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Database (Supabase/PostgreSQL)
# Get from Supabase Dashboard > Settings > Database
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Redis (Upstash)
# Get from Upstash Console > Redis > Connection Details
REDIS_URL=redis://default:password@host:6379/0

# Security
# Generate with: openssl rand -base64 32
SECRET_KEY=your-super-secret-key-min-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
API_KEY_PREFIX=dp_
API_KEY_LENGTH=32

# Rate Limits (requests per minute)
RATE_LIMIT_FREE=10
RATE_LIMIT_STARTER=100
RATE_LIMIT_PRO=500
RATE_LIMIT_BUSINESS=2000

# OCR Settings
OCR_LANG=ru
OCR_USE_GPU=false
OCR_DET_DB_THRESH=0.3
OCR_DET_DB_BOX_THRESH=0.6
MAX_FILE_SIZE_MB=20

# FNS API (Russian Tax Service)
FNS_API_BASE_URL=https://proverkacheka.nalog.ru:9999/v1
FNS_API_TIMEOUT=30
FNS_MAX_RETRIES=3

# Stripe Billing
# Get from Stripe Dashboard > Developers > API Keys
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_API_VERSION=2024-06-20

# Stripe Price IDs (create in Stripe Dashboard > Products)
STRIPE_PRICE_FREE=price_free
STRIPE_PRICE_STARTER=price_starter_monthly
STRIPE_PRICE_PRO=price_pro_monthly
STRIPE_PRICE_BUSINESS=price_business_monthly

# Email (Resend recommended)
# Get from Resend Dashboard > API Keys
EMAIL_FROM=noreply@docparser.ru
EMAIL_API_KEY=re_xxx
EMAIL_PROVIDER=resend

# Client Webhooks
WEBHOOK_TIMEOUT=10
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_DELAYS=[60,300,900]

# Sentry (optional)
# Get from Sentry > Settings > Projects > Client Keys
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# CORS
CORS_ORIGINS=["http://localhost:3000","https://docparser.ru"]

# File Storage (Supabase Storage)
STORAGE_BUCKET=documents
STORAGE_PUBLIC_URL=https://your-project.supabase.co/storage/v1/object/public/documents

# ---------------------------------------------------------------------------
# Telegram bot (runs locally over long polling, no hosting needed)
# ---------------------------------------------------------------------------
# Token from @BotFather
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram id. Send /id to the bot and it will show it.
# Only this account gets the approve/deny buttons for paid access.
TELEGRAM_ADMIN_ID=0
# Free documents before the bot asks the owner to hand over paid access.
TELEGRAM_TRIAL_LIMIT=3
TELEGRAM_STATE_FILE=./storage/bot_users.json
TELEGRAM_MAX_FILE_MB=20